rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Common authentication helper
    function isAuthenticated() {
      return request.auth != null;
    }

    // User profile documents (lookup and presence)
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }

    // Direct chats and nested messages
    match /chats/{chatId} {
      allow read, write: if isAuthenticated();

      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }

    // 1-on-1 WebRTC Calls and candidate signaling subcollections
    match /calls/{callId} {
      allow read, write: if isAuthenticated();

      match /callerCandidates/{candidateId} {
        allow read, write: if isAuthenticated();
      }

      match /calleeCandidates/{candidateId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Multi-peer Mesh Conferences and participant signaling subcollections
    match /conferences/{roomId} {
      allow read, write: if isAuthenticated();

      match /participants/{participantId} {
        allow read, write: if isAuthenticated();

        match /signals/{signalId} {
          allow read, write: if isAuthenticated();
        }
      }
    }
  }
}
